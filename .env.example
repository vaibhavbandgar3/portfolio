# Optional. A read-only GitHub token (no scopes needed) raises the API rate limit
# for the "Recently on GitHub" section. Server-side only.
GITHUB_TOKEN=

# Optional. Any endpoint that accepts a JSON POST of { name, email, message },
# e.g. a Formspree form URL. Without it, the contact form opens the visitor's mail app.
NEXT_PUBLIC_CONTACT_ENDPOINT=
